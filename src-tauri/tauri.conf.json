{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spice Route",
  "version": "1.6.0",
  "identifier": "com.spiceroute.codexsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spice Route",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Move Codex sessions safely between your computers",
    "longDescription": "Spice Route creates verified and recoverable Codex session handoffs using an existing Google Drive, OneDrive, or iCloud folder.",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
