<Window x:Class="SpiceRoute.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="{ThemeResource SpiceSidebar}">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Grid x:Name="TitleStrip" Margin="16,0,150,0">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Boat.png" Width="20" Height="20"/>
        <TextBlock Text="Spice Route" FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact" IsPaneOpen="False" CompactPaneLength="64" OpenPaneLength="220" IsBackButtonVisible="Collapsed" AlwaysShowHeader="False" IsSettingsVisible="True" SelectionChanged="OnNavigationChanged" Background="{ThemeResource SpiceSidebar}">
      <NavigationView.PaneHeader><Image Source="ms-appx:///Assets/Boat.png" Width="34" Height="34" Margin="14,8,12,14"/></NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Overview" Tag="overview" Icon="Home"/>
        <NavigationViewItem Content="What to sync" Tag="selection" Icon="Folder"/>
        <NavigationViewItem Content="Recovery" Tag="recovery" Icon="Clock"/>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter><TextBlock x:Name="VersionText" Margin="14,12" FontSize="11"/></NavigationView.PaneFooter>
      <Grid Background="{ThemeResource SpiceSurface}" CornerRadius="8,0,0,0" Padding="28,24,28,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="0,0,0,14" MaxWidth="560" HorizontalAlignment="Left"/>
        <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Grid>
    </NavigationView>
    <Grid Grid.Row="2" Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ConnectionText" Text="Starting sync engine…" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Windows app" FontSize="11" VerticalAlignment="Center"/></Grid>
  </Grid>
</Window>
