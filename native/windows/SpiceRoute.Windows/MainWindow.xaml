<Window
    x:Class="SpiceRoute.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="{ThemeResource SpiceSidebar}">
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="*" />
      <RowDefinition Height="29" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleStrip" Margin="14,0,150,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Boat.png" Width="18" Height="18" />
        <TextBlock Text="Spice Route" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <NavigationView
        x:Name="Navigation"
        Grid.Row="1"
        PaneDisplayMode="LeftCompact"
        IsPaneOpen="False"
        IsPaneToggleButtonVisible="True"
        CompactPaneLength="64"
        OpenPaneLength="220"
        IsBackButtonVisible="Collapsed"
        AlwaysShowHeader="False"
        IsSettingsVisible="True"
        SelectionChanged="OnNavigationChanged"
        Background="{ThemeResource SpiceSidebar}">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Overview" Tag="overview" Icon="Home" Margin="8,2" MinHeight="40" ToolTipService.ToolTip="Overview" />
        <NavigationViewItem Content="What to sync" Tag="selection" Icon="Folder" Margin="8,2" MinHeight="40" ToolTipService.ToolTip="What to sync" />
        <NavigationViewItem Content="Recovery" Tag="recovery" Icon="Clock" Margin="8,2" MinHeight="40" ToolTipService.ToolTip="Recovery" />
      </NavigationView.MenuItems>
      <Grid Background="{ThemeResource SpiceSurface}" Padding="32,22,32,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            x:Name="Notice"
            IsOpen="False"
            IsClosable="True"
            Margin="0,0,0,10"
            MaxWidth="440"
            HorizontalAlignment="Left" />
        <ContentControl
            x:Name="PageHost"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
      </Grid>
    </NavigationView>

    <Grid Grid.Row="2" Margin="16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="ConnectionText" Text="Starting sync engine…" FontSize="11" Foreground="{ThemeResource SpiceTextSecondary}" VerticalAlignment="Center" />
      <TextBlock x:Name="BuildText" Grid.Column="1" FontSize="11" Foreground="{ThemeResource SpiceTextSecondary}" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
